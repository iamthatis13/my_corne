#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;

            label = "Shift/Caps";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E           &kp R           &kp T                            &tog 7          &kp Y        &kp U          &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D           &kp F           &kp G                    &tog 6  &to 0   &tog 3  &kp H        &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&td0       &kp Z  &kp X  &kp C           &kp V           &kp B      &kp C_MUTE            &tog 4          &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &lt 3 LEFT_WIN  &kp LEFT_SHIFT  &lt 1 RET                                        &lt 2 SPACE  &kp RIGHT_ALT  &lt 4 DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "Num/Sym";
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR  &kp PERCENT                   &none         &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSPACE
&kp GRAVE  &kp N1           &kp N2       &kp N3     &kp N4      &kp N5                 &none  &to 0  &none  &kp N6     &kp N7         &kp N8        &kp N9                &kp N0                 &kp COLON
&none      &none            &none        &none      &none       &none        &trans           &none         &kp MINUS  &kp PLUS       &kp COMMA     &kp DOT               &kp FSLH               &kp EQUAL
                                         &none      &none       &mo 1                                       &none      &sk RIGHT_ALT  &kp DELETE
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "Func/Brace";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp F6                         &none         &kp F7     &kp F8     &kp F9      &kp F10   &kp F11   &kp BACKSPACE
&none   &none   &none   &none   &none           &none                   &none  &to 0  &none  &kp MINUS  &kp EQUAL  &kp LBKT    &kp RBKT  &kp BSLH  &kp F12
&none   &none   &none   &none   &none           &none         &trans           &none         &kp UNDER  &kp PLUS   &kp LBRC    &kp RBRC  &kp PIPE  &none
                        &none   &kp LEFT_SHIFT  &kp LEFT_ALT                                 &mo 2      &mo 4      &kp DELETE
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Navigation {
            bindings = <
&kp LA(TAB)     &none               &none  &none  &none  &none                   &none                      &kp HOME         &kp PAGE_UP    &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp BACKSPACE
&kp LCTRL       &kp LC(LEFT_SHIFT)  &none  &none  &none  &none            &none  &to 0               &none  &kp LEFT_ARROW   &kp DOWN       &kp UP           &kp RIGHT       &none            &none
&kp LEFT_SHIFT  &none               &none  &none  &none  &none  &trans           &kp LG(DOWN_ARROW)         &kp END          &kp PAGE_DOWN  &none            &none           &none            &none
                                           &mo 3  &none  &none                                              &kp RIGHT_SHIFT  &none          &kp DELETE
            >;

            label = "NAV";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Macro {
            bindings = <
&none      &none      &kp LA(TAB)  &kp LC(X)  &kp LC(LS(V))  &kp DELETE                   &none         &kp HOME   &kp N7  &kp N8      &kp N9  &none  &kp BACKSPACE
&kp LC(Z)  &kp LC(Y)  &kp TAB      &kp LC(C)  &kp LC(V)      &kp SPACE             &none  &to 0  &none  &kp RIGHT  &kp N4  &kp N5      &kp N6  &none  &none
&kp LG(V)  &kp N1     &kp N2       &kp N8     &kp N9         &kp BSPC    &trans           &none         &kp N0     &kp N1  &kp N2      &kp N3  &none  &none
                                   &mo 3      &mkp LCLK      &kp RETURN                                 &mo 2      &mo 4   &kp DELETE
            >;

            label = "Macro";
        };

        System {
            bindings = <
&kp LS(LC(ESCAPE))  &none  &none  &none  &none       &none                           &none         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
&kp LC(LA(DELETE))  &none  &none  &none  &none       &none                    &none  &to 0  &none  &none         &none         &none         &none         &none         &none
&kp LG(L)           &none  &none  &none  &sys_reset  &soft_off  &bt BT_CLR           &none         &soft_off     &sys_reset    &none         &none         &none         &none
                                  &none  &none       &none                                         &mo 2         &mo 4         &none
            >;

            label = "System";
        };

        Game {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T                       &none         &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp RCTRL  &kp A  &kp S  &kp D  &kp F  &kp G                &none  &to 0  &none  &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp RET
&td0       &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE           &none         &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                         &none  &none  &none                                     &none  &none  &none
            >;

            label = "Game";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Read {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &trans                      &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &to 0               &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE            &kp LG(DOWN_ARROW)          &trans          &trans          &trans        &trans           &trans  &trans
                        &trans  &trans  &trans                                                    &kp ENTER       &kp SPACE       &trans
            >;

            label = "Read";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Sytem {
            if-layers = <2 4>;
            then-layer = <5>;
        };
    };
};
